{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Filters on status_code=\"STATUS_CODE_ERROR\" (the OTel-spec value for explicit errors); flat/no-data is expected while there are no real errors.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (service, span_name)",
          "legendFormat": "{{service}} {{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Error rate over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "TraceQL {status=error}. Empty is normal for this POC while there are no real errors.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 2,
      "targets": [{ "query": "{status=error}", "queryType": "traceql", "refId": "A" }],
      "title": "Error trace search",
      "type": "table"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Span-attribute filter (http.response.status_code is not a span-metrics label, so this must be a TraceQL panel against Tempo, not a Prometheus table). Includes forms-runner-queue-worker's outbound calls.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 3,
      "targets": [
        {
          "query": "{resource.service.name=~\"forms-runner|forms-admin|forms-runner-queue-worker\" && span.http.response.status_code >= 500}",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx traces by route",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "sum(rate(traces_service_graph_request_total{client=\"forms-runner\"}[5m])) by (server) — shows forms-runner→forms-admin, →redis, →forms-runner (own DB), →forms-runner-queue (SolidQueue DB).",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(traces_service_graph_request_total{client=\"forms-runner\"}[5m])) by (server)",
          "legendFormat": "{{server}}",
          "refId": "A"
        }
      ],
      "title": "forms-runner dependency call volume",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "traces_service_graph_request_failed_total does not exist in this Tempo/Prometheus setup — using CLIENT-span-kind spanmetrics errors as the substitute signal for failed outbound dependency calls.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (service, span_name)",
          "legendFormat": "{{service}} {{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Outbound (CLIENT-span) error rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 42,
  "tags": ["forms", "tracing-poc", "errors"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(traces_spanmetrics_calls_total, service)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Forms - Errors & Health",
  "uid": "forms-errors-health",
  "weekStart": ""
}
