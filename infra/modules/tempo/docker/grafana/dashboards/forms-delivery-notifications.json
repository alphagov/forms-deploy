  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Submission delivery and notification emails** - confirmation emails to the person submitting, submission emails/S3 delivery to the receiving organisation, batch (daily/weekly) digests, and the background jobs that poll for SES bounce/complaint/delivery-confirmation events. All three job queues (`submissions`, `confirmation_emails`, `background`) are shared by more than one job class each, and Tempo isn't configured with custom span-metrics dimensions to split by job class - so the rate/latency/error panels below show queue-level totals, while the *recent traces* tables show the actual job class (`code.namespace`) and, for emails, the real subject line per send.",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"deliver.action_mailer\"}[1h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Emails sent (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"deliver.action_mailer\", status_code=\"STATUS_CODE_ERROR\"}[1h]) or vector(0))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Email send errors (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"submissions publish\"}[1h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Submissions enqueued (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"confirmation_emails publish\"}[1h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Confirmation emails enqueued (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rate of deliver.action_mailer spans - every email actually handed to the delivery backend, across all mailers (confirmation, submission, batch).",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"deliver.action_mailer\"}[5m]))",
          "legendFormat": "emails/s",
          "refId": "A"
        }
      ],
      "title": "Email send rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{span_name=\"deliver.action_mailer\"}[15m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(traces_spanmetrics_latency_bucket{span_name=\"deliver.action_mailer\"}[15m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{span_name=\"deliver.action_mailer\"}[15m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Email send latency (p50/p90/p99)",
      "type": "timeseries"
    },
