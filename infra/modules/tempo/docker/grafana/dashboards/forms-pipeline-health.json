    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The gap between \"accepted by alloy\" and \"received at tempo\"/\"sent to tempo\" is expected and is the point of alloy's filter: SolidQueue's internal dispatch/polling spans get dropped before they ever reach Tempo. A large, steady gap here is the filter working correctly, not a fault.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))",
          "legendFormat": "accepted by alloy",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_spans_total[5m]))",
          "legendFormat": "refused by alloy",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_failed_spans_total[5m]))",
          "legendFormat": "failed at alloy",
          "refId": "C"
        },
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m]))",
          "legendFormat": "sent to tempo",
          "refId": "D"
        },
        {
          "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))",
          "legendFormat": "received at tempo",
          "refId": "E"
        }
      ],
      "title": "OTLP span flow: alloy → tempo",
      "type": "timeseries"
    },
