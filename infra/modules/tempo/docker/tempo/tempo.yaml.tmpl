# Rendered at container startup by gomplate - see Dockerfile. Only the S3
# bucket/region are templated from env vars; everything else is static, so
# this same image works in any environment.
stream_over_http_enabled: true

server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"

storage:
  trace:
    backend: s3
    s3:
      # Tempo's S3 client (minio-go) has no default endpoint of its own -
      # unlike the AWS SDK, it errors ("does not follow ip address or
      # domain name standards") if this is left blank, so it must be set
      # explicitly to the real AWS regional endpoint.
      endpoint: "s3.{{ .Env.AWS_REGION }}.amazonaws.com"
      bucket: "{{ .Env.TEMPO_S3_BUCKET }}"
      region: "{{ .Env.AWS_REGION }}"
    wal:
      path: /var/tempo/wal

# Derives service-graph and span-metrics from ingested spans and writes them
# to prometheus (same task, over localhost - see ecs.tf) so Grafana's
# service graph view has something to query. Metrics aren't S3-backed like
# traces are - losing them on a task restart just means the graph rebuilds
# itself as new spans come in.
metrics_generator:
  registry:
    external_labels:
      source: tempo
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://localhost:9090/api/v1/write
        send_exemplars: true

overrides:
  defaults:
    metrics_generator:
      processors: ["service-graphs", "span-metrics"]

usage_report:
  reporting_enabled: false
