// Rendered as-is - Alloy's own config language handles anything
// environment-specific natively via sys.env(), so unlike tempo/mimir this
// image needs no templating step at container startup.

// OTLP pipeline for all three apps (forms-admin, forms-runner, and its
// queue worker): receive, drop SolidQueue's internal dispatch/polling
// noise (only ever matches queue-worker-originated spans - forms-admin/
// forms-runner web traces pass straight through unaffected), forward the
// rest to Tempo.
otelcol.receiver.otlp "apps" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.drop_polling_noise.input]
  }
}

otelcol.processor.filter "drop_polling_noise" {
  error_mode = "ignore"
  traces {
    span = [
      "IsMatch(span.name, \"SolidQueue::.*\")",
      "span.name == \"ActiveRecord.transaction\"",
      "IsMatch(span.name, \"(BEGIN|COMMIT|SELECT|INSERT|UPDATE|DELETE) forms-runner-queue\")",
    ]
  }
  output {
    traces = [tail_sampling_config.tail_sampling.default.input]
  }
}

// The tail-sampling policy (keep errors, keep slow traces, ratio-sample the
// rest) lives outside this image entirely - see
// infra/modules/tempo/alloy-remote-config.tf and
// alloy-remote-config/tail-sampling.alloy (a sibling of this docker/
// directory, not part of it) for the tracked source of what's pushed
// there. import.http polls it and hot-reloads on change, so tuning the
// ratio/threshold doesn't need an image rebuild or a service redeploy -
// only pushing a new object to S3 (validated by `alloy validate` in
// pre-commit/CI first).
import.http "tail_sampling_config" {
  url            = sys.env("ALLOY_REMOTE_CONFIG_URL")
  poll_frequency = "30s"
}

tail_sampling_config.tail_sampling "default" {
  output = [otelcol.processor.batch.default.input]
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_ENDPOINT")
  }
}

// Meta-monitoring: alloy's own metrics plus mimir's and tempo's (all
// reachable via their existing internal ALB endpoints, no extra
// infrastructure beyond the tempo-metrics route added for this), remote
// written into mimir alongside everything else it stores.
// __address__ takes a bare host:port, not a URL - MIMIR_HOST/
// TEMPO_METRICS_HOST are the same hostnames as MIMIR_URL/
// TEMPO_OTLP_ENDPOINT above, without the scheme.
prometheus.scrape "self" {
  targets = [
    { "__address__" = "localhost:12345", "job" = "alloy" },
    { "__address__" = sys.env("MIMIR_HOST"), "job" = "mimir" },
    { "__address__" = sys.env("TEMPO_METRICS_HOST"), "job" = "tempo" },
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "mimir" {
  endpoint {
    url = sys.env("MIMIR_URL") + "/api/v1/push"
  }
}
